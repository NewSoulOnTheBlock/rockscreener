# ---------------------------------------------------------------------------
# RockScreener — the environment.
#
# THIS FILE HOLDS SECRETS AND ADDRESSES. Every threshold, rate and ceiling lives
# in apps/backend/configuration.json instead, where it is committed, reviewable
# and diffable. Nothing that is a tuning decision belongs here, where it would
# be invisible to everyone except whoever last deployed.
#
# `cp .env.example .env` and fill in what you have. THE PRODUCT DEGRADES
# HONESTLY: without a Helius key the launch analysis never runs and every
# bundle reading stays null (which lowers coverage and blocks calls rather than
# inventing a number); without a master key it cannot hold wallets and says so;
# without a session secret nobody can sign in and the whole screener still
# serves.
# ---------------------------------------------------------------------------

# --- stores ---------------------------------------------------------------
DATABASE_URL=postgresql://rock:rock@localhost:5440/rockscreener?schema=public
REDIS_URL=redis://localhost:6390

# --- the gateway ----------------------------------------------------------
PORT=4040
# Exact origins, comma separated. A wildcard is not an option: the session
# cookie is sent with credentials, and `credentials` plus `*` is forbidden by
# specification.
CORS_ORIGINS=http://localhost:3040
LOG_LEVEL=info

# --- Solana ---------------------------------------------------------------
# TWO ENDPOINTS ON PURPOSE. Reads are bulk work that will eat a rate limit;
# sending a swap is one request that must not queue behind four hundred of them.
# Point both at the same URL if you only have one, and accept the coupling.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_TRADE_RPC_URL=

# Enables the first-slot bundle analysis — the reading this product is named
# for. Without it, `bundledPct` and `sniperPct` stay NULL rather than zero: the
# launch pillar goes unmeasured, coverage drops, calls do not fire on unanalysed
# launches, and auto-trade refuses them outright. The RugCheck insider graph
# still supplies the funding-cluster reading, which is the more predictive half.
HELIUS_API_KEY=

# Optional. Without it the aggregator's lite host is used, which is rate limited
# far more tightly — fine for a single-user deployment, not for a public one.
JUPITER_API_KEY=

# --- the platform token ---------------------------------------------------
# ROCK. Overridable so a staging deployment can point at a test mint; the
# default is the real one and is compiled into @rockscreener/shared.
ROCK_MINT=7LxC96Ag4DnBotK6bMMUj4kdneAo1kdV1xHnzVF5s7W2

# --- sign-in --------------------------------------------------------------
# `openssl rand -hex 32`. Without it NOBODY CAN SIGN IN and every account route
# answers 503 — the screener itself is unaffected. A guessable session secret is
# worse than no sign-in at all, which is why there is no default.
SESSION_SECRET=

# The Login Widget's bot token. Absent, the Telegram button is greyed out with a
# reason rather than offered and then failing at the last step.
#
# The SAME bot also sends the engine's fill and disarm messages — the engine runs
# while nobody is watching, so a fill that only appears in a log nobody has open
# is one the owner finds out about from their balance. Only fills and disarms are
# sent: a notification per refusal is how somebody mutes the bot on day one and
# then misses the message that mattered.
TELEGRAM_LOGIN_BOT_TOKEN=

# --- custody --------------------------------------------------------------
# `openssl rand -hex 32`. Encrypts every custodial trading key with AES-256-GCM.
#
# IT LIVES ONLY IN THIS PROCESS ENVIRONMENT: never written to the database,
# never logged, never returned by any endpoint. LOSING IT LOSES EVERY WALLET AND
# THERE IS NO RECOVERY PATH — a recoverable master key is simply a second copy
# of it. Without it the API serves the whole screener and reports the terminal
# as unconfigured; the trader exits cleanly with one line saying why.
WALLET_MASTER_KEY=

# --- optional platform fee ------------------------------------------------
# Basis points taken on fills. Zero, or an unset wallet, disables it entirely.
PLATFORM_FEE_BPS=0
PLATFORM_FEE_WALLET=

# --- the web app ----------------------------------------------------------
# Read at BUILD time by Next.js and inlined into the client bundle. It is the
# address the BROWSER uses, so it is localhost rather than a compose service
# name. Leave it unset and the app serves its own fixtures instead.
NEXT_PUBLIC_API_URL=http://localhost:4040
PUBLIC_API_URL=http://localhost:4040

# The bot's @username, WITHOUT the @. The Telegram Login Widget is a script that
# renders its own button and needs to know which bot it is signing into; it is a
# public identifier, unlike the token above.
NEXT_PUBLIC_TELEGRAM_BOT=
