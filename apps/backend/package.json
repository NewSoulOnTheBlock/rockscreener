{
  "name": "@rockscreener/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:api": "tsx watch --env-file=../../.env src/gateway.ts",
    "dev:indexer": "tsx watch --env-file=../../.env src/indexer.ts",
    "dev:scorer": "tsx watch --env-file=../../.env src/scorer.ts",
    "dev:trader": "tsx watch --env-file=../../.env src/trader.ts",
    "build": "pnpm --filter @rockscreener/backend^... build && prisma generate && tsc -p tsconfig.json",
    "start:api": "node dist/gateway.js",
    "start:indexer": "node dist/indexer.js",
    "start:scorer": "node dist/scorer.js",
    "start:trader": "node dist/trader.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:sql": "tsx --env-file=../../.env scripts/apply-sql.ts",
    "db:setup": "pnpm db:push && pnpm db:sql",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rockscreener/shared": "workspace:*",
    "@prisma/client": "^6.19.2",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "pino": "^9.6.0",
    "ws": "^8.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "pg": "^8.13.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
